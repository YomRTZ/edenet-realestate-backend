{
  "name": "hardhat",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prisma:compose": "node src/prisma/compose-schema.mjs",
    "db:migrate": "npm run prisma:compose && npx prisma migrate dev --schema src/prisma/schema.generated.prisma",
    "db:generate": "npm run prisma:compose && npx prisma generate --schema src/prisma/schema.generated.prisma",
    "prisma:studio": "npm run prisma:compose && npx prisma studio --schema src/prisma/schema.generated.prisma"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.7",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.21",
    "chai": "^6.2.2",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.9.0",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "prisma": "^7.8.0"
  }
}
