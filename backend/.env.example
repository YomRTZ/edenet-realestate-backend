# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/realestate"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Blockchain ────────────────────────────────────────────────────────────────
RPC_URL="http://127.0.0.1:8545"
GOV_WALLET="0xYourGovernmentWalletAddress"
GOV_PRIVATE_KEY="0xYourGovernmentPrivateKey"
PROPERTY_NFT_ADDRESS="0xYourPropertyNFTContractAddress"
MARKETPLACE_ADDRESS="0xYourMarketplaceContractAddress"

# ── Email (Gmail App Password) ────────────────────────────────────────────────
GMAIL_USER="your@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL="http://localhost:3000"
