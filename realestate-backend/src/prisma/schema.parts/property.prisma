datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PropertyStatus {
  PENDING
  PENDING_APPROVAL
  ACTIVE
  SOLD
  RENTED
  INACTIVE
  UNDER_CONTRACT
}

enum FileType {
  IMAGE
  DOCUMENT
}

model Property {
  id                String          @id @default(uuid())
  tokenId           String          @unique // Assigned sequentially upon successful minting
  ownerWallet       String
  status            PropertyStatus  @default(PENDING)

  title             String
  description       String?
  propertyType      String
  listingType       String
  bedrooms          Int             @default(0)
  bathrooms         Int             @default(0)
  areaSize          Int             @default(0)
  lotSize           Int             @default(0)
  parkingSpots      Int             @default(0)
  yearBuilt         Int             @default(0)
  propertyTax       Float           @default(0)
  hoaFees           Float           @default(0)
  
  city              String
  state             String
  zipCode           String
  country           String
  petPolicy         String?
  isFurnished       Boolean         @default(false)

  // Web3 Hashing Integrity Layers
  metadataHash      String?         @db.VarChar(64)
  imagesRootHash    String?         @db.VarChar(64)
  documentsRootHash String?         @db.VarChar(64)
  chainHash         String?         @db.VarChar(66) // On-chain transaction receipt hash

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  files             PropertyFile[]
  metadataVersions  MetadataVersion[]

  @@map("properties")
}

model PropertyFile {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  type       FileType
  fileName   String
  fileUrl    String
  sha256Hash String   @db.VarChar(64) // Unique verification hash per file
  createdAt  DateTime @default(now())

  @@map("property_files")
}

model MetadataVersion {
  id           String   @id @default(uuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  version      Int      @default(1)
  metadataHash String   @db.VarChar(64)
  snapshot     Json     // Raw deterministic metadata structured payload mapping
  createdAt    DateTime @default(now())

  @@map("metadata_versions")
}
